{
    "python-envs.pythonProjects": [
        {
            "path": ".",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ],
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.testing.pytestEnabled": true,
    "python.testing.pytestArgs": [
        "host/tests"
    ],
    "files.exclude": {
        "**/.DS_Store": true,
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "archive": true,
        "epuck-stm32-main/build": true,
        "epuck-esp32-main/build": true
    },
    "search.exclude": {
        ".venv": true,
        "archive": true,
        "epuck-stm32-main/build": true,
        "epuck-stm32-main/Drivers": true,
        "epuck-esp32-main/build": true,
        "data/sessions": true
    }
}
