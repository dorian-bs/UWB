{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "RxDebug",
            "inherits": "Debug",
            "cacheVariables": {
                "UWB_BOARD_ID": "2",
                "UWB_BOARD_ROLE": "RX"
            }
        },
        {
            "name": "TxDebug",
            "inherits": "Debug",
            "cacheVariables": {
                "UWB_BOARD_ID": "1",
                "UWB_BOARD_ROLE": "TX"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "RxDebug",
            "configurePreset": "RxDebug"
        },
        {
            "name": "TxDebug",
            "configurePreset": "TxDebug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        }
    ]
}